# Overrides for `docker compose`. Copy to `.env` to use them; every value below
# is the default that applies when the variable is unset.
#
# The API's own settings live in apps/api/.env.example — docker-compose.yml
# passes the handful that a local stack cares about, and the zod schema in
# apps/api/src/config/env.schema.ts defaults the rest.

# Host port for the API. The web container's API_URL follows this, so changing
# it here is enough.
API_PORT=3000
# Host port for the SPA. The API's CORS_ORIGINS follows this, so changing it
# here is enough.
WEB_PORT=8080

# Host ports published by docker-compose.dev.yml only, on 127.0.0.1.
REDIS_PORT=6379
MONGO_PORT=27017

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# x-api-key that DELETE /api/v1/rates/cache requires. The stack runs the API as
# NODE_ENV=production, where the schema refuses to start without one; this
# default is a local placeholder rather than a secret.
ADMIN_API_KEY=local-admin-key

# TTL of the fresh rates cache key, in seconds. Lower it to watch the upstream
# call happen; Monobank allows one request per minute.
RATES_CACHE_TTL_SECONDS=300
# TTL of the long-lived stale fallback key, in seconds.
RATES_STALE_TTL_SECONDS=86400
