        ]
      }
    },
    "/api/v1/rates/history": {
      "get": {
        "description": "One point per archived UTC day inside the window that published the pair, oldest first. The archive holds the last snapshot of each day, so a point is that day at its close rather than an average of it, and the orientation is the upstream's own: `base`/`quote` is asked for exactly as published, never inverted or crossed.",
        "operationId": "RatesController_getHistory",
        "parameters": [
          {
            "description": "ISO 4217 alpha-3 code of the currency being priced, as the upstream publishes the pair. Case-insensitive; the response echoes it upper-cased.",
            "in": "query",
            "name": "base",
            "required": true,
            "schema": {
              "example": "USD",
              "maxLength": 3,
              "minLength": 3,
              "pattern": "^[A-Za-z]{3}$",
              "type": "string"
            }
          },
          {
            "description": "ISO 4217 alpha-3 code the price is expressed in, on the same terms. The orientation is exact: the archive is asked for the pair the upstream published, not for one derived from it.",
            "in": "query",
            "name": "quote",
            "required": true,
            "schema": {
              "example": "UAH",
              "maxLength": 3,
              "minLength": 3,
              "pattern": "^[A-Za-z]{3}$",
              "type": "string"
            }
          },
          {
            "description": "How many UTC days back to read, counting today as the first. The upper bound is the widest window this API answers; a wider one is refused here rather than answered short. The archive retention (`RATES_ARCHIVE_TTL_DAYS`) is never below it — the process refuses to start if it is — so every day inside the bound is one the archive is still keeping. A deployment may keep more than that; those days are past what this route accepts.",
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 7,
              "example": 7,
              "maximum": 90,
              "minimum": 1,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RatesHistoryResponseDto"
                }
              }
            },
            "description": "The archived series, oldest first. Shorter than `days` wherever the archive has a gap."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "The request failed validation."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "The request is well formed but cannot be satisfied with the current rates."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "The rate limit for this client is spent."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "An unexpected failure. The message is generic by design."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponseDto"
                }
              }
            },
            "description": "A dependency the request needs is unavailable."
          }
        },
        "summary": "Return the archived daily rates for one published pair",
        "tags": [
          "rates"
        ]
      }
    },
