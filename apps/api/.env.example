# Every variable below is optional: the zod schema in src/config/env.schema.ts
# applies these exact defaults, and the process fails fast on an invalid value.

# Runtime environment. Controls log formatting (pretty in development, JSON otherwise).
NODE_ENV=development
# HTTP port the API listens on.
PORT=3000
# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Express `trust proxy`: false trusts nobody, true trusts every hop, and a
# number is how many proxies sit in front of this process. It decides whether
# the client ip comes from X-Forwarded-For, which the rate limit buckets and the
# request log both depend on. Set it to 1 behind a single nginx or on Railway.
TRUST_PROXY=false

# Redis connection string, used for the rates cache and its stale fallback.
REDIS_URL=redis://localhost:6379
# Deadline for a single Redis command, in milliseconds. The cache sits on the
# request path, so a command that never comes back has to be given up on rather
# than waited out; the lookup then degrades to an upstream call.
REDIS_COMMAND_TIMEOUT_MS=300
# MongoDB connection string, used for the conversion history.
MONGO_URL=mongodb://localhost:27017/currency_converter
# How long the driver looks for a reachable Mongo before failing a command.
# Kept short: a conversion writes its history record on the way out and must
# not wait on a database that is down.
MONGO_SERVER_SELECTION_TIMEOUT_MS=3000
# Deadline for a single conversion-history read or write, in milliseconds.
# Server selection bounds the search for a server, not one that answers slowly,
# so this is what keeps a hung Mongo from holding a conversion open.
HISTORY_OPERATION_TIMEOUT_MS=1000
# How long a conversion record is kept, in days, enforced by a TTL index.
HISTORY_TTL_DAYS=30

# Upstream exchange-rate source. Monobank allows one request per minute.
MONOBANK_API_URL=https://api.monobank.ua/bank/currency
# Per-request timeout for the upstream call, in milliseconds.
MONOBANK_TIMEOUT_MS=5000
# Total upstream attempts, including the first one. 429 responses are never retried.
MONOBANK_RETRY_ATTEMPTS=3
# Base delay for the exponential backoff with full jitter, in milliseconds.
MONOBANK_RETRY_BASE_DELAY_MS=300
# Ceiling on one upstream call including every retry and the backoff between
# them, in milliseconds. Past it the stale cache copy is the better answer.
MONOBANK_TOTAL_BUDGET_MS=8000

# Consecutive upstream failures that trip the circuit breaker open.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# How long the breaker stays open before allowing a single trial call, in milliseconds.
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# TTL of the fresh rates cache key (rates:latest), in seconds.
RATES_CACHE_TTL_SECONDS=300
# TTL of the long-lived stale fallback key (rates:fallback), in seconds.
RATES_STALE_TTL_SECONDS=86400
# How long an archived daily snapshot is kept, in days, enforced by a TTL index
# on `fetchedAt`. It is also the widest window GET /rates/history can answer,
# and the depth of the archive fallback the rates lookup ends on.
RATES_ARCHIVE_TTL_DAYS=90
# Deadline for a single archive upsert or read, in milliseconds. The archive is
# written on the way out of every upstream fetch, so a Mongo that answers slowly
# must not hold the response that fetched it open.
RATES_ARCHIVE_OPERATION_TIMEOUT_MS=1000

# Rate limit window, in seconds.
THROTTLE_TTL_SECONDS=60
# Requests allowed per window, per client.
THROTTLE_LIMIT=60

# Admin key for DELETE /api/v1/rates/cache, sent as the x-api-key header.
# Leave unset in development and test to keep cache invalidation open. Required
# when NODE_ENV=production: the route clears the snapshot every instance reads,
# and without a key anyone who can reach the deployment can spend the one
# request a minute the upstream allows.
ADMIN_API_KEY=
